generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id                 Int               @id @default(autoincrement())
  name               String
  email              String            @unique
  passwordHash       String            @map("password_hash")
  role               Role
  failedAttempts     Int               @default(0) @map("failed_attempts")
  lockedUntil        DateTime?         @map("locked_until")
  createdAt          DateTime          @default(now()) @map("created_at")
  auditLogs          AuditLog[]
  capturedBiometrics Biometric[]       @relation("BiometricCapturedBy")
  overrideRecords    OverrideRecord[]  @relation("SupervisorOverrides")
  manualReviewRequests ManualReviewRequest[] @relation("ManualReviewOfficers")
  manualReviews       ManualReviewRequest[]   @relation("ManualReviewSupervisors")
  reports            Report[]
  verificationLogs   VerificationLog[] @relation("OfficerVerifications")
  notifications      Notification[]

  @@map("users")
}

model Traveler {
  id               Int               @id @default(autoincrement())
  fan              String            @unique @map("fan")
  fullName         String            @map("full_name")
  dateOfBirth      DateTime          @map("date_of_birth")
  gender           Gender
  nationality      String
  photo            String?
  enrollmentStatus EnrollmentStatus  @default(DRAFT) @map("enrollment_status")
  enrollmentDate   DateTime          @default(now()) @map("enrollment_date")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  biometric        Biometric?
  verificationLogs VerificationLog[]
  manualReviewRequests ManualReviewRequest[]
  alertStatus      AlertStatus       @default(NONE) @map("alert_status")
  alertReason      String?           @map("alert_reason")

  @@map("travelers")
}

model Biometric {
  id                  Int      @id @default(autoincrement())
  travelerId          Int      @unique @map("traveler_id")
  fingerprintTemplate Bytes    @map("fingerprint_template")
  irisTemplate        Bytes    @map("iris_template")
  capturedBy          Int      @map("captured_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  capturedByUser      User     @relation("BiometricCapturedBy", fields: [capturedBy], references: [id])
  traveler            Traveler @relation(fields: [travelerId], references: [id], onDelete: Cascade)

  @@index([capturedBy])
  @@map("biometrics")
}

model VerificationLog {
  id               Int                @id @default(autoincrement())
  travelerId       Int                @map("traveler_id")
  officerId        Int                @map("officer_id")
  fingerprintScore Float              @map("fingerprint_score")
  irisScore        Float              @map("iris_score")
  finalScore       Float              @map("final_score")
  threshold        Float
  status           VerificationStatus @default(PENDING)
  systemDecision   Decision?          @map("system_decision")
  finalDecision    Decision?          @map("final_decision")
  timestamp        DateTime           @default(now())
  
  direction                 BorderDirection?    @default(ENTRY)
  checkpointId              Int?                @map("checkpoint_id")
  decisionReason            String?             @map("decision_reason")
  alertStatusAtVerification AlertStatus?        @map("alert_status_at_verification")
  alertReasonAtVerification String?             @map("alert_reason_at_verification")

  overrideRecord   OverrideRecord?
  manualReviewRequest ManualReviewRequest?
  officer          User               @relation("OfficerVerifications", fields: [officerId], references: [id])
  traveler         Traveler           @relation(fields: [travelerId], references: [id])
  checkpoint       Checkpoint?        @relation(fields: [checkpointId], references: [id])

  @@index([travelerId])
  @@index([officerId])
  @@index([systemDecision])
  @@map("verification_logs")
}

model Checkpoint {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  location         String?
  isActive         Boolean            @default(true) @map("is_active")
  createdAt        DateTime           @default(now()) @map("created_at")
  verificationLogs VerificationLog[]

  @@map("checkpoints")
}

model OverrideRecord {
  id               Int             @id @default(autoincrement())
  verificationId   Int             @unique @map("verification_id")
  supervisorId     Int             @map("supervisor_id")
  previousDecision Decision        @map("previous_decision")
  newDecision      Decision        @map("new_decision")
  reason           String
  timestamp        DateTime        @default(now())
  supervisor       User            @relation("SupervisorOverrides", fields: [supervisorId], references: [id])
  verification     VerificationLog @relation(fields: [verificationId], references: [id])

  @@index([supervisorId])
  @@map("override_records")
}

model ManualReviewRequest {
  id             Int                  @id @default(autoincrement())
  travelerId     Int                  @map("traveler_id")
  officerId      Int                  @map("officer_id")
  verificationId Int?                 @unique @map("verification_id")
  reason         ManualReviewReason
  officerNotes   String               @map("officer_notes")
  attachments    Json                 @default("[]")
  decision       ManualReviewDecision?
  status         ManualReviewStatus   @default(PENDING)
  supervisorId   Int?                 @map("supervisor_id")
  supervisorNotes String?              @map("supervisor_notes")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  traveler       Traveler             @relation(fields: [travelerId], references: [id])
  officer        User                 @relation("ManualReviewOfficers", fields: [officerId], references: [id])
  supervisor     User?                @relation("ManualReviewSupervisors", fields: [supervisorId], references: [id])
  verification   VerificationLog?     @relation(fields: [verificationId], references: [id])

  @@index([travelerId])
  @@index([officerId])
  @@index([supervisorId])
  @@index([status])
  @@map("manual_review_requests")
}

model AuditLog {
  id           Int        @id @default(autoincrement())
  userId       Int?       @map("user_id")
  action       String
  level        AuditLevel @default(INFO)
  ipAddress    String     @map("ip_address")
  timestamp    DateTime   @default(now())
  resourceType String?    @map("resource_type")
  resourceId   String?    @map("resource_id")
  result       String?
  description  String?
  metadata     Json?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([level])
  @@index([timestamp])
  @@index([result])
  @@map("audit_logs")
}

model Report {
  id              Int        @id @default(autoincrement())
  reportType      ReportType @map("report_type")
  reportTitle     String     @map("report_title")
  startDate       DateTime   @map("start_date")
  endDate         DateTime   @map("end_date")
  generatedBy     Int        @map("generated_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  
  // Store applied filters as JSON
  filters         Json?      @default("{}")
  
  // Store summary statistics as JSON
  summaryData     Json?      @map("summary_data")
  
  // Store record count
  recordCount     Int        @default(0) @map("record_count")
  
  // Historical snapshot of chart aggregations at generation time
  chartData       Json?
  
  // Historical snapshot of the detailed verification records at generation time,
  // so an old report stays historically accurate even if live data changes later.
  recordsData     Json?
  
  generatedByUser User       @relation(fields: [generatedBy], references: [id])

  @@index([generatedBy])
  @@index([createdAt])
  @@map("reports")
}

enum Role {
  OFFICER
  SUPERVISOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum Decision {
  VERIFIED
  PENDING_SUPERVISOR_REVIEW
  REJECTED
}

enum ReportType {
  VERIFICATION_SUMMARY
  OVERRIDE_SUMMARY
  OFFICER_ACTIVITY
  MANUAL_REVIEW_SUMMARY
  BORDER_CROSSING
  BIOMETRIC_VERIFICATION
  ENTRY_EXIT
  CHECKPOINT_ACTIVITY
}

enum EnrollmentStatus {
  DRAFT
  COMPLETED
}

enum ManualReviewReason {
  FINGERPRINT_INJURY
  IRIS_INJURY
  BIOMETRIC_UNAVAILABLE
  THRESHOLD_BREACH
  ALERT_WARNING
  QUALITY_ISSUE
}

enum ManualReviewDecision {
  APPROVED_OVERRIDE
  REJECTED
  REQUEST_RE_ENROLLMENT
}

enum ManualReviewStatus {
  PENDING
  APPROVED
  REJECTED
  RE_ENROLLMENT_REQUESTED
}

enum VerificationStatus {
  PENDING
  COMPLETED
}

enum AuditLevel {
  INFO
  WARNING
  CRITICAL
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  title       String
  message     String
  type        String   @default("INFO")
  isRead      Boolean  @default(false)  @map("is_read")
  createdAt   DateTime @default(now())  @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum BorderDirection {
  ENTRY
  EXIT
}

enum AlertStatus {
  NONE
  WARNING
  CRITICAL
}
